CC      = gcc
CFLAGS  = -Wall -Wextra -std=c11 -D_POSIX_C_SOURCE=200809L -g
LDLIBS_SHM = -pthread -lrt

BINS = fifo_server fifo_client shm_server shm_client

.PHONY: all clean datos limpiar-ipc

all: $(BINS)

fifo_server: fifo_server.c busqueda.c busqueda.h fifo_comun.h
	$(CC) $(CFLAGS) -o $@ fifo_server.c busqueda.c

fifo_client: fifo_client.c fifo_comun.h busqueda.h
	$(CC) $(CFLAGS) -o $@ fifo_client.c

shm_server: shm_server.c busqueda.c busqueda.h shm_comun.h
	$(CC) $(CFLAGS) -o $@ shm_server.c busqueda.c $(LDLIBS_SHM)

shm_client: shm_client.c shm_comun.h busqueda.h
	$(CC) $(CFLAGS) -o $@ shm_client.c $(LDLIBS_SHM)

# Genera datos.csv (2 millones de filas por defecto): make datos N=5000000
N ?= 2000000
datos:
	./generar_csv.sh $(N)

# Borra recursos IPC que hayan quedado de una ejecucion incorrecta
limpiar-ipc:
	rm -f /tmp/so_fifo_req /tmp/so_fifo_resp
	rm -f /dev/shm/so_practica1_shm

clean:
	rm -f $(BINS)
